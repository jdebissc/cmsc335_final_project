<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dictionary</title>
    <link rel="stylesheet" href="index.css">
</head>
<body>
    <div id="nav">
        <img id="icon" src="images/inkscape_book.png" alt="">
        <b id="website-name">
            Word Website
        </b>
        <span id="links">
            <a href="/">Home</a>
            <a selected href="/dictionary">Dictionary</a>
            <a href="/hangman">Hangman</a>
        </span>
    </div>
    <div id="content">
        <form action="" method="GET">
            <input name="word" type="text" placeholder="enter a word">
            <p>
                Type in a word above to see its pronunciation and definitions.
                Word data is pulled from <a href="https://dictionaryapi.dev/">https://dictionaryapi.dev/</a>.
            </p>
            <% if (valid) { %>
                <fieldset>
                    <legend>Your word: <i><%= word %></i></legend>
                    <h2><%= phonetic %></h2>
                    <% if (origin !== "") { %>
                        <b>Origin:</b> <%= origin %>
                        <br><br>
                    <% } %>
                    <table>
                        <thead>
                            <tr>
                                <th>Usage</th>
                                <th>Definition</th>
                                <th>Example</th>
                            </tr>
                        </thead>
                        <tbody>
                        <% for (let meaning of meanings) { %>
                            <% for (let i = 0; i < meaning.definitions.length; ++i) { %>
                                <tr>
                                    <% if (i === 0) { %>
                                        <td rowspan=<%= "" + meaning.definitions.length %>><%= meaning.partOfSpeech %></td>
                                    <% } %>
                                    <td><%= meaning.definitions[i].definition %></td>
                                    <td><%= meaning.definitions[i].example %></td>
                                </tr>
                            <% } %>
                        <% } %>
                        </tbody>
                    </table>
                    <br>
                </fieldset>
            <% } %>
        </form>
    </div>
</body>
</html>