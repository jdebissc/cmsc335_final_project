<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hangman</title>
    <link rel="stylesheet" href="index.css">
</head>
<body>
    <script defer src="hangman.js"></script>
    <div id="nav">
        <img id="icon" src="images/inkscape_book.png" alt="">
        <b id="website-name">
            Word Website
        </b>
        <span id="links">
            <a href="/">Home</a>
            <a href="/dictionary">Dictionary</a>
            <a selected href="/hangman">Hangman</a>
        </span>
    </div>
    <div id="content">
        <div id="terrapin">
            <div class="tile"></div>
            <div class="tile"></div>
            <div class="tile"></div>
            <div class="tile"></div>
            <div class="tile"></div>
            <div class="tile"></div>
            <div class="tile"></div>
            <div class="tile"></div>
            <div class="tile"></div>
        </div>
        <!-- This is wrapped in a form just to detect if user presses enter -->
        <form onsubmit="guess_letters(event);">
            <strong><u id="hint-text">Guess a letter</u></strong>
            <input id="guess-input" type="text" autocomplete="off" maxlength="1">
        </form>
        <form method="POST">
            <fieldset id="hangman">
                <legend>Current Game</legend>
                <h3 id="guessed-word">START A GAME</h3>
                <table borderless>
                    <tbody>
                        <tr>
                            <td class="hangman-labels"><strong>Guessed letters:</strong></td>
                            <td id="guessed-letters">--</td>
                        </tr>
                        <tr>
                            <td class="hangman-labels"><strong>Wrong guesses:</strong></td>
                            <td id="guess-count">--</td>
                        </tr>
                        <tr>
                            <td class="hangman-labels"><strong>Time elapsed:</strong></td>
                            <td id="timer">--</td>
                        </tr>
                        <tr>
                            <td class="hangman-labels"><strong>Score:</strong></td>
                            <td>
                                <input readonly name="score" type="text" id="score-count" value="0">
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br>
                <input id="name-input" type="text" name="name" placeholder="your name">
                <br>
                <input type="button" onclick="new_hangman_game();" value="NEW GAME">
                <input id="submit-button" type="submit" value="SAVE SCORE">
            </fieldset>
        </form>
    </div>
</body>
</html>