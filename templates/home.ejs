<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Word Website</title>
    <link rel="stylesheet" href="index.css">
</head>
<body>
    <div id="nav">
        <img id="icon" src="images/inkscape_book.png" alt="">
        <b id="website-name">
            Word Website
        </b>
        <span id="links">
            <a selected href="/">Home</a>
            <a href="/dictionary">Dictionary</a>
            <a href="/hangman">Hangman</a>
        </span>
    </div>
    <div id="content">
        <fieldset>
            <legend>Hangman Top Scores</legend>
            <% if (scores.length === 0) { %>
                No scores yet. Play hangman to add yours!
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>Place</th>
                            <th>Name</th>
                            <th>Score</th>
                            <th>Played</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (let i = 0; i < scores.length; ++i) { %>
                            <tr place=<%= "" + (i + 1) %>>
                                <td><%= i + 1 %></td>
                                <td><%= scores[i].name %></td>
                                <td><%= scores[i].score %></td>
                                <td><%= scores[i].date.toDateString() %></td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            <% } %>
        </fieldset>
    </div>
</body>
</html>